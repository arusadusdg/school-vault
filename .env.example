# Copy to .env and fill in. .env is gitignored and never committed.

CANVAS_BASE_URL=https://pamojaeducation.instructure.com
CANVAS_COURSE_ID=734
CANVAS_CLASS_SLUG=cs-hl
CANVAS_TOKEN=

# Crawl cutoff: first day of term. Nothing older is fetched.
TERM_START=2026-08-01

# Skip attachments bigger than this. GitHub hard-rejects files over 100 MB.
MAX_ATTACHMENT_MB=50

# Toddle. User/org/curriculum ids are read out of the saved session file.
# Only the academic year has to be set, and it changes once a year.
TODDLE_ACADEMIC_YEAR_ID=

# Local login session from `playwright codegen --save-storage`.
TODDLE_STORAGE_FILE=storage_state.json
# In GitHub Actions this holds the same file, base64-encoded, and wins over the path above.
TODDLE_STORAGE_STATE=
