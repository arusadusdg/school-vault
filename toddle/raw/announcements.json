{"data":{"node":{"id":"257282207784114885","circularFeedV3":{"pageInfo":{"hasNextPage":false,"endCursor":null,"__typename":"PageInfo"},"edges":[{"node":{"id":"425448747737029413","title":"Welcome to the IB DP","bannerV2":{"id":"425448934622634782","url":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/CqyfANudcl/UIl3PrV06.png","name":"ai generated back to school school board education sign drawing","type":"IMAGE","mimeType":"image/png","metadata":{"size":287101,"height":723,"width":1280},"__typename":"Attachment"},"description":"<p class=\"tde-paragraph\" dir=\"ltr\" data-sessionid=\"LazVAIG0YN\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Dear new DP1 students,</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">welcome back to school and welcome to the beginning of your next journey: the IB Diploma Programme.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">You should have all received the welcome information and package from your homeroom teacher Ms. Meraviglia in the last days. Please check that you can all log into Toddle before the welcome week. Previous MYP students can use their usual school email accounts to log in. </span><br /><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Our new DP1 students can log into the system with their private email accounts and we will change them to the school email accounts in the course of the next week. Go to </span><a href=\"https://www.toddleapp.com/\" class=\"tde-link\" target=\"_blank\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">https://www.toddleapp.com/</span></a><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">, click on \"Sign in\", use the student account, and if you have a GMAIL account, simply click on GMAIL and use your regular GMAIL data. If you cannot log in, do not worry and simply reach out to me. I can send you a one-time password and we will switch your accounts to the school email accounts anyways next week. On Toddle, you can already find your homeroom class, the TOK class, the CAS class, and the Extended Essay class. All subjects and the timetable function will be added at the beginning of next week.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Please bring your current DP subject choice list with you in the welcome week. I have received mulitple emails with requests to change levels and subjects during the break and I tried my best to include them all into my subject choice document. However, I want to go through each subject choice with every student to check that we fulfil all requirements for IB (and also German universities) and to ensure that you will be enrolled into the correct classes. In addition, please bring a laptop or tablet (and a charger), so that you can participate properly.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">I am looking forward to meeting you all in the course of next week. Please be in front of the school on Monday by 7:55. Ms. Meraviglia will meet you there and guide you to your classroom. I will check in in the course of the day and introduce you to some basics regarding the IB Diploma Programme and the different types of assessment in this year. </span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Have a great start everyone!</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">All the best,</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Mr. Metzger (IB Diploma Programme Coordinator)</span></p>","isPublished":true,"isArchived":false,"publishedAt":"2026-09-12T07:40:53.758Z","isRead":true,"isNew":false,"updatedAt":"2026-09-12T07:40:53.758Z","archivedAt":null,"createdBy":{"id":"257729689668298611","firstName":"Constantin","middleName":null,"lastName":"Metzger","type":"staff","email":"constantin.metzger@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/Dhmg8R8ho/Profilhead.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"publishedBy":{"id":"257729689668298611","firstName":"Constantin","middleName":null,"lastName":"Metzger","type":"staff","email":"constantin.metzger@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/Dhmg8R8ho/Profilhead.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"updatedBy":{"id":"257729689668298611","firstName":"Constantin","middleName":null,"lastName":"Metzger","type":"staff","email":"constantin.metzger@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/Dhmg8R8ho/Profilhead.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"archivedBy":null,"state":"PUBLISHED","isV2":true,"__typename":"Circular","entityMap":{"entityType":"GRADE","schoolGroups":null,"__typename":"CircularEntityMap"}},"__typename":"CircularEdge"},{"node":{"id":"425225020223002534","title":"Change to Dance Club _Club list","bannerV2":{"id":"425225572369568122","url":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/k5VBKUMYQ6/lOoUVA_Va.png","name":"man dance performance ballet dancer guy male movement jump pose portrait dance dance dance dance dance ballet dancer dancer dancer jump jump","type":"IMAGE","mimeType":"image/png","metadata":{"size":57843,"height":720,"width":1280},"__typename":"Attachment"},"description":"<p class=\"tde-paragraph\" dir=\"ltr\" data-sessionid=\"GlzprN6Puq\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Dear School Community,</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">I have made one change to the club list table. Only Dance Club has changed its timeslot.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><b><strong class=\"tde-text-bold\" style=\"font-size:14px;font-weight:600\">The updated list is attached.</strong></b></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Kind regards</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Roslyn Stricker</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p>","isPublished":true,"isArchived":false,"publishedAt":"2026-09-11T16:47:51.383Z","isRead":true,"isNew":false,"updatedAt":"2026-09-11T16:47:51.383Z","archivedAt":null,"createdBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"publishedBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"updatedBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"archivedBy":null,"state":"PUBLISHED","isV2":true,"__typename":"Circular","entityMap":{"entityType":"GRADE","schoolGroups":null,"__typename":"CircularEntityMap"}},"__typename":"CircularEdge"},{"node":{"id":"425107854781845523","title":"DP1 CAS_English B _ notebooks required","bannerV2":{"id":"425108859137302570","url":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/DguaF8WrE3/8N9rztncO.png","name":"hand write pen notebook journal planner writing paper pages open notebook notes desk person work working writer taking notes write journal writing writing writing writing work work writer writer writer writer writer","type":"IMAGE","mimeType":"image/png","metadata":{"size":151939,"height":853,"width":1280},"__typename":"Attachment"},"description":"<p class=\"tde-paragraph\" dir=\"ltr\" data-sessionid=\"dWVJMzKHnZ\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Dear DP1 students</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">I am looking forward to guiding you through CAS (and in some cases English B HL) this year :)</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Please make sure you come to our first DP1 CAS lesson with a notebook. This book will be your CAS journal. If you are in my English B class, please also bring a notebook to our first lesson, along with a</span><span class=\"tde-text-underline\" style=\"line-height:20px;font-size:14px;white-space:pre-wrap;text-decoration:underline\"> </span><b><strong class=\"tde-text-bold tde-text-underline\" style=\"font-size:14px;font-weight:600\">hard copy of our textbook</strong></b><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\"> and the novel you were ask to purchase. You might be able to get the textbook second-hand at the Kick-off party next Friday.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">See you all next week.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Ms Stricker</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p>","isPublished":true,"isArchived":false,"publishedAt":"2026-09-11T09:03:28.296Z","isRead":true,"isNew":false,"updatedAt":"2026-09-11T09:03:28.296Z","archivedAt":null,"createdBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"publishedBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"updatedBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"archivedBy":null,"state":"PUBLISHED","isV2":true,"__typename":"Circular","entityMap":{"entityType":"COURSE","schoolGroups":null,"__typename":"CircularEntityMap"}},"__typename":"CircularEdge"},{"node":{"id":"424825390641449489","title":"Second-Hand Book Sale","bannerV2":null,"description":"<p class=\"tde-paragraph\" dir=\"ltr\" data-sessionid=\"iRRXahGOyv\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Dear Parents and Students,</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">We hope you had a wonderful summer break and are looking forward to the new academic year! 😊</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Since many of you have contacted us with questions about books for the new academic year, we have some good news: second-hand books will be available for purchase during the Kick-Off Party on Friday, 18 September.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Students who would like to sell or donate their old books are also very welcome to bring them to the school office during Welcome Week. Please put a note inside each book with:</span></p><ul class=\"tde-list-ul\"><li value=\"1\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">your name</span></li><li value=\"2\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">the price</span></li><li value=\"3\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">your payment details</span></li></ul><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Thank you for helping us give the books a second life and making it easier for everyone to prepare for the new school year! 📚</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">We look forward to seeing you at the school!</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Best regards,</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Valentina</span></p>","isPublished":true,"isArchived":false,"publishedAt":"2026-09-10T14:27:25.461Z","isRead":false,"isNew":false,"updatedAt":"2026-09-10T14:27:25.461Z","archivedAt":null,"createdBy":{"id":"257729689697658741","firstName":"Valentina","middleName":null,"lastName":"Nikolaiesko","type":"staff","email":"valentina.nikolaiesko@fuu.de","profileImage":null,"preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"publishedBy":{"id":"257729689697658741","firstName":"Valentina","middleName":null,"lastName":"Nikolaiesko","type":"staff","email":"valentina.nikolaiesko@fuu.de","profileImage":null,"preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"updatedBy":{"id":"257729689697658741","firstName":"Valentina","middleName":null,"lastName":"Nikolaiesko","type":"staff","email":"valentina.nikolaiesko@fuu.de","profileImage":null,"preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"archivedBy":null,"state":"PUBLISHED","isV2":true,"__typename":"Circular","entityMap":{"entityType":"GRADE","schoolGroups":null,"__typename":"CircularEntityMap"}},"__typename":"CircularEdge"},{"node":{"id":"424767607778838310","title":"Our school clubs_Important","bannerV2":{"id":"424768965835761282","url":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/Us6vD70C-y/JnROvfYdz.png","name":"team friendship group hands cooperation people community connection relationship friendship day team team team team team friendship friendship community community community relationship","type":"IMAGE","mimeType":"image/png","metadata":{"size":182255,"height":853,"width":1280},"__typename":"Attachment"},"description":"<p class=\"tde-paragraph\" dir=\"ltr\" data-sessionid=\"6MsjXT1p33\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Dear School community</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Please find attached an overview of our school clubs for this year. Please read through it with your child and follow the given instructions.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">On </span><b><strong class=\"tde-text-bold\" style=\"font-size:14px;font-weight:600\">Monday, 14 September</strong></b><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">, Homeroom teachers are adding your child's name to a club.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">If you have any questions, please contact me.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Thank you</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Roslyn Stricker</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><iframe src=\"https://view.officeapps.live.com/op/embed.aspx?src=https%3A%2F%2Fcloud.toddleapp.com%2Feu-west-1%2Fp%2FD61l6jmA48Z6%2Fcontent%2FTGSI-mv28%2Fclublistletter2026-27.docx%3Fiat%3D1789036071118%26sig%3Dd25f598420082716c9625aa7cd86da30ab3430dc18d46d0f875b76b096366051\" data-file-type=\"FILE\" data-mime-type=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\" width=\"442\" height=\"265.2\" frameborder=\"0\" title=\"club list letter 2026-27\" id=\"resizable-iframe-123\" class=\"tde-iframe\" style=\"max-width:100%\"></iframe></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p>","isPublished":true,"isArchived":false,"publishedAt":"2026-09-10T10:30:03.327Z","isRead":true,"isNew":false,"updatedAt":"2026-09-10T10:30:03.327Z","archivedAt":null,"createdBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"publishedBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"updatedBy":{"id":"257729689831876481","firstName":"Roslyn","middleName":null,"lastName":"Stricker","type":"staff","email":"roslyn.stricker@fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/j6a5Y4XzZ/Bild1.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"archivedBy":null,"state":"PUBLISHED","isV2":true,"__typename":"Circular","entityMap":{"entityType":"GRADE","schoolGroups":null,"__typename":"CircularEntityMap"}},"__typename":"CircularEdge"},{"node":{"id":"424433883585446002","title":"DP1: welcome to the new academic year!","bannerV2":{"id":"424444837475911325","url":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/ILkd2b4SE/back-to-school-banner-horizontal-poster-with-school-supplies-and-the-inscription-back-to-school-vector.png","name":"back-to-school-banner-horizontal-poster-with-school-supplies-and-the-inscription-back-to-school-vector","type":"IMAGE","mimeType":"image/png","metadata":{"size":718333,"webkitRelativePath":"","height":512,"width":1536},"__typename":"Attachment"},"description":"<p class=\"tde-paragraph\" dir=\"ltr\" data-sessionid=\"faOs6A2R7D\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Dear students and parents,</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">The new academic year is approaching, and I would like to share (or re-share) with all of you, both old and new students, all the information you need to know to navigate the first weeks of school effectively.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">In particular, you will find the following documents attached:</span></p><ul class=\"tde-list-ul\"><li value=\"1\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">The booklist for the entire DP programme</span></li><li value=\"2\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">A welcome letter from Mr. Metzger, Dr. Heinicke and me </span></li><li value=\"3\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">A presentation containing relevant information about the IB DP programme, your DP subjects and teachers, and the</span><b><strong class=\"tde-text-bold\" style=\"font-size:14px;font-weight:600\"> timetable for the first week of school (14.09 - 18.09).</strong></b></li><li value=\"4\" class=\"tde-listitem\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">A document with information about the Meet and Greet evening (22.09) for parents.</span></li></ul><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">I would also like to draw your attention to the fact that we will hold a</span><b><strong class=\"tde-text-bold\" style=\"font-size:14px;font-weight:600\"> kick-off party</strong></b><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\"> at school on</span><b><strong class=\"tde-text-bold\" style=\"font-size:14px;font-weight:600\"> Friday, September</strong></b><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\"> </span><b><strong class=\"tde-text-bold\" style=\"font-size:14px;font-weight:600\">18th, from 13:45 to 16:00.</strong></b><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\"> The event is compulsory for all students, and parents are warmly invited!</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">I am looking forward to this fresh new start, and I will see all of you next Monday.</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Enjoy the rest of your week!</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><br /></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Kind regards</span></p><p class=\"tde-paragraph\" dir=\"ltr\" style=\"text-align:left\"><span style=\"line-height:20px;font-size:14px;white-space:pre-wrap\">Anita Meraviglia</span></p>","isPublished":true,"isArchived":false,"publishedAt":"2026-09-09T13:08:59.084Z","isRead":true,"isNew":false,"updatedAt":"2026-09-09T13:08:59.084Z","archivedAt":null,"createdBy":{"id":"257729689806710655","firstName":"Anita","middleName":null,"lastName":"Meraviglia","type":"staff","email":"anita.meraviglia@doz.fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/mYvcI98a1/DSCF0710_m01.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"publishedBy":{"id":"257729689806710655","firstName":"Anita","middleName":null,"lastName":"Meraviglia","type":"staff","email":"anita.meraviglia@doz.fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/mYvcI98a1/DSCF0710_m01.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"updatedBy":{"id":"257729689806710655","firstName":"Anita","middleName":null,"lastName":"Meraviglia","type":"staff","email":"anita.meraviglia@doz.fuu.de","profileImage":"https://cloud.toddleapp.com/eu-west-1/p/D61l6jmA48Z6/content/mYvcI98a1/DSCF0710_m01.png","preferredName":null,"pronouns":null,"prefix":null,"suffix":null,"__typename":"Staff"},"archivedBy":null,"state":"PUBLISHED","isV2":true,"__typename":"Circular","entityMap":{"entityType":"USER","schoolGroups":null,"__typename":"CircularEntityMap"}},"__typename":"CircularEdge"}],"__typename":"CircularConnectionV3"},"__typename":"Organization"}}}
